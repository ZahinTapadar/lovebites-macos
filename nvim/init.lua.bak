-- ============================================================================
-- Neovim configuration
-- Ghostty-transparent • Helix-flavoured • VS Code-inspired
-- Requires Neovim >= 0.11, git, ripgrep, fd, a C compiler, and node
-- ============================================================================

-- Leader keys
vim.g.mapleader = " "
vim.g.maplocalleader = " "

local o = vim.opt
local map = vim.keymap.set

-- Tell LuaLS that `vim` is the Neovim global.
-- This removes the "Undefined global 'vim'" diagnostics in this file.

-- ============================================================================
-- Editor
-- ============================================================================

o.termguicolors = true
o.number = true
o.relativenumber = true
o.cursorline = true
o.scrolloff = 8
o.colorcolumn = { "80", "100" }
o.signcolumn = "yes"
o.mouse = "a"
o.clipboard = "unnamedplus"

o.splitbelow = true
o.splitright = true

o.undofile = true
o.ignorecase = true
o.smartcase = true

o.updatetime = 2000
o.timeoutlen = 400

o.completeopt = { "menuone", "noselect", "popup" }

o.confirm = true
o.title = true
o.showmode = false
o.laststatus = 3

-- ============================================================================
-- Folding
-- VS Code-style code collapsing
-- ============================================================================

o.foldmethod = "expr"
o.foldexpr = "v:lua.vim.treesitter.foldexpr()"
o.foldlevel = 99
o.foldenable = true
o.foldtext = ""

-- ============================================================================
-- Wrapping
-- ============================================================================

o.wrap = true
o.linebreak = true
o.breakindent = true

-- ============================================================================
-- Indentation
-- ============================================================================

o.expandtab = true
o.shiftwidth = 4
o.tabstop = 4
o.smartindent = true

-- ============================================================================
-- Whitespace
-- ============================================================================

o.list = true
o.listchars = {
    space = "·",
    tab = "→ ",
    eol = "⏎",
    trail = "·",
    nbsp = "␣",
}

-- ============================================================================
-- Cursor
-- ============================================================================

o.guicursor = "n-c:block,i-ci-ve:ver25,v:hor20,r-cr-o:hor20"

-- ============================================================================
-- lazy.nvim
-- ============================================================================

local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"

if not vim.uv.fs_stat(lazypath) then
    vim.fn.system({
        "git",
        "clone",
        "--filter=blob:none",
        "--branch=stable",
        "https://github.com/folke/lazy.nvim.git",
        lazypath,
    })
end

vim.opt.rtp:prepend(lazypath)

-- ============================================================================
-- Plugins
-- ============================================================================

require("lazy").setup({

    -- -------------------------------------------------------------------------
