    -- Telescope
    -- Space + F = files
    -- Space + B = buffers
    -- Space + / = grep
    -- Space + S = symbols
    -- -------------------------------------------------------------------------

    {
        "nvim-telescope/telescope.nvim",
        branch = "master",

        dependencies = {
            "nvim-lua/plenary.nvim",
        },

        cmd = "Telescope",

        keys = {
            {
                "<leader>f",
                function()
                    require("telescope.builtin").find_files({
                        hidden = true,
                        previewer = true,
                    })
                end,
                desc = "File picker",
            },

            {
                "<leader>b",
                "<cmd>Telescope buffers<CR>",
                desc = "Buffers",
            },

            {
                "<leader>/",
                "<cmd>Telescope live_grep<CR>",
                desc = "Global search",
            },

            {
                "<leader>s",
                "<cmd>Telescope lsp_document_symbols<CR>",
                desc = "Symbols",
            },

            {
                "<leader>d",
                "<cmd>Telescope diagnostics bufnr=0<CR>",
                desc = "Diagnostics",
            },

            {
                "<leader>'",
                "<cmd>Telescope resume<CR>",
                desc = "Last picker",
            },
        },

        opts = {
            defaults = {
                winblend = 0,

                file_ignore_patterns = {
                    "^.git/",
                    "node_modules/",
                },

                layout_strategy = "horizontal",

                layout_config = {
                    width = 0.9,
                    horizontal = { preview_width = 0.55, preview_cutoff = 1 },
                },
            },

            pickers = {
                find_files = {
                    hidden = true,
                    previewer = true,
                },

                buffers = {
                    previewer = true,
                },
            },
        },
    },

    -- -------------------------------------------------------------------------
    -- LSP
    -- Python = Pyright
    -- C/C++  = clangd
    -- Lua    = lua_ls
    -- -------------------------------------------------------------------------

    {
        "neovim/nvim-lspconfig",

        dependencies = {
            {
                "mason-org/mason.nvim",
                opts = {},
            },

            {
                "mason-org/mason-lspconfig.nvim",

                opts = {
                    ensure_installed = {
                        "lua_ls",
                        "clangd",
                        "pyright",
                    },

                    automatic_enable = true,
                },
            },
        },

        config = function()
            -- Python
            vim.lsp.config("pyright", {})

            -- C / C++
            -- Mason provides clangd; Homebrew LLVM is also available at:
            -- /opt/homebrew/opt/llvm/bin/clangd
            vim.lsp.config("clangd", {})

            -- Lua
            vim.lsp.config("lua_ls", {
                settings = {
                    Lua = {
                        diagnostics = {
                            globals = { "vim" },
                        },
                    },
                },
            })

            vim.lsp.enable({
                "pyright",
                "clangd",
                "lua_ls",
            })

            vim.api.nvim_create_autocmd("LspAttach", {
                callback = function(ev)
                    local client = vim.lsp.get_client_by_id(ev.data.client_id)

                    if client and client:supports_method("textDocument/inlayHint") then
                        vim.lsp.inlay_hint.enable(true, {
                            bufnr = ev.buf,
                        })
                    end

                    local lsp_map = function(lhs, rhs, desc)
                        map("n", lhs, rhs, {
                            buffer = ev.buf,
                            desc = desc,
                        })
                    end

                    lsp_map("gd", vim.lsp.buf.definition, "Go to definition")
                    lsp_map("gr", vim.lsp.buf.references, "References")
                    lsp_map("gi", vim.lsp.buf.implementation, "Implementation")
                    lsp_map("gy", vim.lsp.buf.type_definition, "Type definition")
                    lsp_map("K", vim.lsp.buf.hover, "Hover documentation")
                    lsp_map("<leader>r", vim.lsp.buf.rename, "Rename symbol")
                    lsp_map("<leader>a", vim.lsp.buf.code_action, "Code action")
                end,
            })

            vim.diagnostic.config({
                virtual_text = {
                    prefix = "●",
                },

                float = {
                    border = "rounded",
                },

                severity_sort = true,
            })
        end,
    },

    -- -------------------------------------------------------------------------
    -- Completion
