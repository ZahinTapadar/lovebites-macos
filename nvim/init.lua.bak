                        python = "Python",
                        cpp = "C++",
                        c = "C",
                        javascript = "JavaScript",
                        typescript = "TypeScript",
                        html = "HTML",
                        css = "CSS",
                        json = "JSON",
                        markdown = "Markdown",
                        bash = "Bash",
                        rust = "Rust",
                        java = "Java",
                    }

