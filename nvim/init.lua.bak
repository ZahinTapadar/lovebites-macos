    -- -------------------------------------------------------------------------
    {
        "vyfor/cord.nvim",
        opts = {
            display = {
                theme = "catppuccin",
                flavor = "accent",
                view = "full",
            },

            text = {
                editing = function(opts)
                    local languages = {
                        lua = "Lua",
                        python = "Python",
                        cpp = "C++",
                        c = "C",
                        javascript = "JavaScript",
                        typescript = "TypeScript",
