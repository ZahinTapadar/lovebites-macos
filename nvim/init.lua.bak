    -- -------------------------------------------------------------------------
    -- Tree-sitter
    -- New main-branch API for Neovim 0.11+
    -- -------------------------------------------------------------------------

       {
       "nvim-lualine/lualine.nvim",
       dependencies = { "nvim-tree/nvim-web-devicons" },
       opts = function()
           local t = {}
           for _, m in ipairs({ "normal", "insert", "visual", "replace", "command", "inactive" }) do
               t[m] = {
                   a = { fg = "#88c0d0", bg = "NONE", gui = "bold" },
                   b = { fg = "#d8dee9", bg = "NONE" },
                   c = { fg = "#d8dee9", bg = "NONE" },
               }
           end
           return {
               options = { theme = t, section_separators = "", component_separators = "│", globalstatus = true },
               sections = {
                   lualine_a = { "mode" }, lualine_b = { { "filename", path = 1 } }, lualine_c = {},
                   lualine_x = { "diagnostics", "branch", "diff" }, lualine_y = { "location", "filetype" }, lualine_z = {},
               },
           }
       end,
   },


    {
        "nvim-treesitter/nvim-treesitter",
        branch = "main",
        lazy = false,
        build = ":TSUpdate",

        config = function()
            local ts = require("nvim-treesitter")

            ts.setup({})

            ts.install({
                "lua",
                "vim",
                "vimdoc",
                "c",
                "cpp",
                "python",
                "bash",
                "json",
                "yaml",
                "toml",
                "markdown",
                "markdown_inline",
            })

            vim.api.nvim_create_autocmd("FileType", {
                callback = function(ev)
                    pcall(vim.treesitter.start, ev.buf)

                    if vim.treesitter.language.get_lang(ev.match) then
                        vim.bo[ev.buf].indentexpr =
                        "v:lua.require'nvim-treesitter'.indentexpr()"
                    end
                end,
            })
        end,
    },

