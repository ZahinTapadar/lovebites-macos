{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo.png",
        "height": 19,
        "padding": { "top": 1, "left": 1, "right": 3 }
    },
    "modules": [
        

        "os",
        "host",
        "uptime",
        "packages",
        "shell",
        "break",
        "cpu",
        "gpu",
        {
            "type": "memory",
            "key": "Memory ",
            "percent": {
                "type": 3
            }
        },
        {
            "type": "swap",
            "key": "Swap   ",
            "percent": {
                "type": 3
            }
        },
        {
            "type": "disk",
            "key": "Disk   ",
            "percent": {
                "type": 3
            }
        },
        {
            "type": "battery",
            "key": "Battery",
            "percent": {
                "type": 3
            }
        },
        "break",
        "colors"
    ]
}